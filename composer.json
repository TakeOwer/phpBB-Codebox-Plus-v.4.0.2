	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Huynh Buu Tam (o0johntam0o)",
			"email": "o0johntam0o@gmail.com",
			"homepage": "https://github.com/o0johntam0o",
			"role": "Original author"
		},
		{
			"name": "Salvo Cortesiano",
			"email": "info@netshadows.de",
			"homepage": "https://www.netshadows.de/ombra/",
			"role": "phpBB 3.3 rewrite and maintainer"
		}
	],
	"require": {
		"php": ">=7.2.0",
