{
	"name": "salvocortesiano/codeboxplus",
	"type": "phpbb-extension",
	"description": "Codebox Plus: syntax highlighting for 250+ languages (GeSHi), responsive code boxes with copy, select, wrap, line numbers, full screen, expand/collapse and protected download of the code. phpBB 3.3 rewrite of the original Codebox Plus by o0johntam0o.",
	"homepage": "https://www.netshadows.de/ombra/",
